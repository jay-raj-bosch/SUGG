# ─────────────────────────────────────────────────────────────────
#  Suggestion Management System — Backend Environment Variables
#  Copy this file to .env and fill in your actual values.
#
#  NOTE FOR .NET BACKEND TEAM:
#  This Node.js backend is being replaced by a .NET Web API.
#  This file documents all environment variables and their purpose.
#  Replicate these settings in your appsettings.json / appsettings.Production.json.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=suggestion_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── JWT (app-issued token) ────────────────────────────────────────
# The backend issues its OWN JWT after validating credentials or SSO token.
# The frontend reads these exact fields from the JWT payload:
#   { employeeNo, name, role, plantCode }
# role must be "employee" or "admin" (lowercase).
# plantCode must be "PLT-01" (BidP) or "PLT-02" (JaP).
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# CORS – comma-separated list of allowed frontend origins
# Development: http://localhost:5173
# Production:  https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173

# File storage path (for attachment uploads)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=4194304

# ── SSO Configuration ─────────────────────────────────────────────
# The frontend calls POST /api/auth/sso-exchange with the SSO access
# token. The backend validates it with the SSO provider and responds
# with { token, user } where token is the app-issued JWT above.
#
# Azure AD example:
SSO_TENANT_ID=your-azure-tenant-id
SSO_CLIENT_ID=your-azure-client-id
SSO_CLIENT_SECRET=your-azure-client-secret
SSO_AUTHORITY=https://login.microsoftonline.com/your-azure-tenant-id

# ── JSON serialization (CRITICAL for .NET) ───────────────────────
# The frontend expects ALL JSON property names in camelCase.
# In ASP.NET Core, add this to Program.cs:
#
#   builder.Services.AddControllers().AddJsonOptions(o =>
#       o.JsonSerializerOptions.PropertyNamingPolicy = JsonNamingPolicy.CamelCase);
#
# Without this, fields like employeeNo will come back as EmployeeNo
# and silently break the entire frontend without an obvious error.
