# ─────────────────────────────────────────────────────────────────
#  Suggestion Management System — Frontend Environment Variables
#  Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────

# Base URL of the backend API.
# For local Node dev server:     http://localhost:4000/api
# For local .NET dev server:     https://localhost:7001/api
# For production .NET server:    https://your-server.com/api
VITE_API_URL=http://localhost:4000/api

# ── Demo / Offline mode ───────────────────────────────────────────
# When true, the app seeds from built-in mock data when the backend
# is unreachable. Set to false once the real backend is live so
# failures surface as visible errors instead of silent fallbacks.
VITE_DEMO_MODE=true

# ── SSO Configuration ─────────────────────────────────────────────
# Set VITE_SSO_MODE=true when the .NET backend SSO exchange endpoint
# (POST /api/auth/sso-exchange) is ready.
# The frontend will redirect to the SSO provider for login and then
# call POST /api/auth/sso-exchange with the received access token.
# The backend validates the SSO token and returns { token, user }.
VITE_SSO_MODE=false

# SSO provider — Azure AD example:
VITE_SSO_AUTHORITY=https://login.microsoftonline.com/YOUR_TENANT_ID
VITE_SSO_CLIENT_ID=YOUR_APP_CLIENT_ID
VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_SSO_SCOPE=openid profile email
